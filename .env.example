# Sofia AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Twilio (telephony + SMS + Media Streams)
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN is the account Auth Token from the Twilio console.
# Used to validate the X-Twilio-Signature header on incoming /twiml webhooks
# (HMAC-SHA1 per https://www.twilio.com/docs/usage/webhooks/webhooks-security).
# Backend refuses to start if this is unset or shorter than 16 chars.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Twilio number we send outbound SMS FROM (usually same as TWILIO_PHONE_NUMBER).
# Used by backend/lib/twilio-sms.js for lead notifications + send_sms_link tool.
TWILIO_FROM_NUMBER=

# Parviz's cell — where inbound-lead SMS notifications are delivered.
# E.164 format. Never commit a real value.
LEAD_NOTIFICATION_PHONE=

# OpenAI Realtime API (STT + GPT-4o brain + TTS)
# NOTE: this key is ALSO used for the transcript-fallback pass via gpt-4o-mini
# in backend/lib/transcript-fallback.js. Same key, two models.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Google Calendar API (booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# SQLite
DATABASE_PATH=./data/sofia.db

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# WebSocket Media Stream auth
# ------------------------------------------------------------
# Shared secret embedded in the TwiML <Stream><Parameter> element
# and validated on the Twilio Media Stream `start` event before any
# audio is relayed to OpenAI. Rotate by:
#   fly secrets set STREAM_AUTH_TOKEN=<new value>
# then redeploying. Backend refuses to start if this is unset or
# shorter than 16 chars.
#
# Generate:  openssl rand -hex 32     # or: openssl rand -base64 32
# Minimum acceptable length: 32 chars. Never commit a real value.
# (Renamed from the earlier TWILIO_WEBHOOK_SECRET — Twilio itself
# does not use a separate "webhook secret"; signatures use the
# account Auth Token above.)
# ============================================================
STREAM_AUTH_TOKEN=
