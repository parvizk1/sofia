# Sofia AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Twilio (telephony + SMS + Media Streams)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Twilio "from" number used by the Netlify lead-routing function.
# Same number as TWILIO_PHONE_NUMBER if you only own one — kept separate
# so SMS sender is decoupled from the voice agent number if needed later.
TWILIO_FROM_NUMBER=+18737360217

# Destination for high-value lead SMS notifications (Pro / Complete bundles).
# Set to Parviz's mobile to be paged when a hot lead comes in.
LEAD_NOTIFICATION_PHONE=+18737360217

# OpenAI Realtime API (STT + GPT-4o brain + TTS)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Google Calendar API (booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# SQLite
DATABASE_PATH=./data/sofia.db

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# WebSocket auth (signed token for Twilio Media Streams)
TWILIO_WEBHOOK_SECRET=
